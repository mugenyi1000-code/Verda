# Verda server — copy to .env and fill in. Never commit .env.

# Postgres. Any managed Postgres works (Railway, Render, Neon, RDS, a VPS).
DATABASE_URL=postgres://verda:verda@localhost:5432/verda

# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating this signs every existing session out. Never reuse across environments.
SESSION_SECRET=

# Where the browser app is served from, for CORS and cookie scope.
# Comma-separated. No wildcard: credentials are sent with requests.
ALLOWED_ORIGINS=http://localhost:8080

# Set to 1 in production so session cookies carry Secure.
# Leave unset for local http development or you will not stay signed in.
COOKIE_SECURE=

# Anthropic API key for the drafting proxy. Server-side only — it must never
# reach the browser. Leave empty to run with drafting disabled.
ANTHROPIC_API_KEY=

PORT=3000
